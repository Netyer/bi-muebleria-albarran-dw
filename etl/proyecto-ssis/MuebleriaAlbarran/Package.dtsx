                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Fechas AS (
    SELECT DISTINCT
        CAST(fecha AS DATE) AS fecha
    FROM dbo.ventas
    WHERE fecha IS NOT NULL
)
SELECT
    CONVERT(INT, CONVERT(CHAR(8), fecha, 112)) AS id_tiempo,
    fecha,
    CAST('00:00:00' AS TIME(0)) AS hora,
    CASE (DATEDIFF(DAY, '19000101', fecha) % 7)
        WHEN 0 THEN 'Lunes'
        WHEN 1 THEN 'Martes'
        WHEN 2 THEN 'Miércoles'
        WHEN 3 THEN 'Jueves'
        WHEN 4 THEN 'Viernes'
        WHEN 5 THEN 'Sábado'
        WHEN 6 THEN 'Domingo'
    END AS dia_semana,
    DAY(fecha) AS dia,
    MONTH(fecha) AS mes,
    YEAR(fecha) AS anio
FROM Fechas;</property>
