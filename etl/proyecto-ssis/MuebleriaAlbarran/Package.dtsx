                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    e.empleado_id AS id_empleado,
    e.nombre AS nombre_empleado,
    LTRIM(RTRIM(CONCAT(
        e.appaterno, ' ', e.apmaterno
    ))) AS apellidos_empleado,
    c.nombre AS cargo,
    CAST(e.fecha_contrato AS DATE) AS fecha_contrato,
    CAST(e.sueldo_base AS INT) AS sueldo
FROM dbo.empleados AS e
LEFT JOIN dbo.cargos AS c
    ON e.cargo_id = c.cargo_id;</property>
